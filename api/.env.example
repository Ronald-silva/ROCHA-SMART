# PostgreSQL (mesma URL do Prisma/Neon; use driver asyncpg na URL)
DATABASE_URL=postgresql://user:pass@localhost:5432/rocha
APP_ENV=development
# Neon costuma exigir TLS no host pooler
DATABASE_SSL=false

# Em produção, use um valor aleatório com pelo menos 32 caracteres.
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Mapa JSON client_id -> client_secret (frontend + agente IA)
AUTH_CLIENTS_JSON={"frontend":"dev-frontend","ai-agent":"dev-ai"}

# Catálogo / feeds (Google Merchant + Meta)
CATALOG_SITE_URL=https://www.example.com
# Opcional: permitir ?token=... no feed sem JWT
CATALOG_FEED_TOKEN=

# Integrações dropshipping (opcional)
ZENDROP_API_BASE=
ZENDROP_API_KEY=
ALIEXPRESS_API_BASE=
ALIEXPRESS_API_KEY=

# Segredos para POST /webhooks/suppliers/{provider}/...
WEBHOOK_SECRET_ZENDROP=
WEBHOOK_SECRET_ALIEXPRESS=
WEBHOOK_SECRET_GENERIC=

# Em produção, use apenas origens explícitas, separadas por vírgula.
CORS_ORIGINS=http://localhost:3000

ANTHROPIC_API_KEY=
SDR_MODEL=claude-3-5-haiku-latest
SDR_ENABLED=true
SDR_GATEWAY_SECRET=troque-por-um-segredo-de-32-caracteres
SDR_IDENTITY_HASH_SALT=troque-por-outro-segredo-de-32-caracteres
SDR_USAGE_STORE=memory
SDR_STORE_FAILURE_POLICY=closed
SDR_RATE_LIMIT_PER_MINUTE=5
SDR_DAILY_QUOTA=30
SDR_MONTHLY_BUDGET_USD=20
SDR_MAX_MESSAGE_CHARS=2000
SDR_MAX_HISTORY_MESSAGES=6
SDR_MAX_OUTPUT_TOKENS=700
SDR_MAX_TOOL_CYCLES=2
SDR_TIMEOUT_SECONDS=20
SUPPLIER_SYNC_MAX_CHANGES=50
SUPPLIER_SYNC_MAX_PRICE_CHANGE_PCT=40
SUPPLIER_SYNC_MAX_STOCK_DELTA=500
