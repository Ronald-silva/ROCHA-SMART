# --- Nunca commite senhas reais neste arquivo. Copie para `.env` e preencha localmente. ---

# URL canônica do site (SEO, sitemap, Open Graph, cookies first-party dos pixels)
# Local:
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Produção (Vercel + Cloudflare): use https://rochasmart.com.br (com ou sem www — alinhe ao domínio principal)
# NEXT_PUBLIC_SITE_URL="https://rochasmart.com.br"

# Neon (Prisma): URL com pooler para a app; DIRECT_URL sem `-pooler` para migrações.
# Na URL com host `...-pooler...` inclua `pgbouncer=true` (recomendado pelo Prisma + Neon).
# Ex.: ...neondb?sslmode=require&pgbouncer=true&connect_timeout=15
# https://neon.tech/docs/connect/connection-pooling
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Opcional: variáveis PG* só se alguma ferramenta CLI as exigir (o Prisma usa DATABASE_URL/DIRECT_URL).

# Mesma DATABASE_URL no backend FastAPI (`api/.env`). Após mudanças no schema: em `web/`, `npm run db:push`.

# Meta Pixel (Facebook)
NEXT_PUBLIC_META_PIXEL_ID=

# Google Analytics 4
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Google Ads (ex.: AW-123456789)
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Bridge / afiliado (link do checkout do parceiro)
# Opcional: URL fixa se ainda não houver affiliate.checkout_url no ai_metadata do produto
NEXT_PUBLIC_DEFAULT_AFFILIATE_URL=
# Opcional: template com SKU — ex.: https://parceiro.com/?sku={{sku}}
NEXT_PUBLIC_AFFILIATE_LINK_TEMPLATE=

# Proxy do widget Sara → FastAPI (só servidor; não expor JWT no browser)
INTERNAL_API_BASE_URL=http://127.0.0.1:8000
INTERNAL_API_JWT=
