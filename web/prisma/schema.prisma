// Neon: use a pooled `DATABASE_URL` for the app and `DIRECT_URL` (non-pooler) for migrations.
// https://www.prisma.io/docs/orm/overview/databases/neon

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  sku         String?  @unique
  price       Decimal  @db.Decimal(12, 2)
  stockQuantity Int    @default(0)
  imageUrl    String?
  brand       String?  @default("Rocha Smart")
  /// Especificações técnicas de casa inteligente (JSONB no PostgreSQL)
  ai_metadata Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems        OrderItem[]
  campaignProducts  CampaignProduct[]
}

model Order {
  id        String   @id @default(cuid())
  status    String   @default("pending")
  total     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int     @default(1)
  unitPrice Decimal @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([orderId, productId])
}

model Campaign {
  id        String    @id @default(cuid())
  name      String
  slug      String?   @unique
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products CampaignProduct[]
}

model CampaignProduct {
  campaignId String
  productId  String

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([campaignId, productId])
}
